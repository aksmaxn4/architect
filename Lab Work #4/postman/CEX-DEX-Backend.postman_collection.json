    {
      "name": "Admin Pairs",
      "item": [
        {
          "name": "Validate Pair (base)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"CLAWNCH/USDT\",\n  \"network\": \"base\",\n  \"pool_address\": \"0xa1F72459dfA10BAD200Ac160eCd78C6b77a747be\",\n  \"cex_symbol\": \"CLAWNCHUSDT\",\n  \"meta\": {}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/pairs/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "pairs",
                "validate"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('validate response contract', function () {",
                  "  pm.expect(json).to.have.property('errors');",
                  "  pm.expect(json).to.have.property('warnings');",
                  "  pm.expect(json.errors).to.be.an('array');",
                  "  pm.expect(json.warnings).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Pair (test)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rnd = Date.now().toString().slice(-6);",
                  "pm.collectionVariables.set('createdPairId', '');",
                  "pm.collectionVariables.set('testPairSymbol', `TST${rnd}/USDT`);",
                  "pm.collectionVariables.set('testPairCexSymbol', `TST${rnd}USDT`);",
                  "pm.request.body.update(JSON.stringify({",
                  "  symbol: pm.collectionVariables.get('testPairSymbol'),",
                  "  network: 'base',",
                  "  pool_address: '0x1111111111111111111111111111111111111111',",
                  "  cex_symbol: pm.collectionVariables.get('testPairCexSymbol'),",
                  "  meta: {},",
                  "  is_enabled: true",
                  "}, null, 2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('pair created', function () {",
                  "  pm.expect(json.id).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('createdPairId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"TST000000/USDT\",\n  \"network\": \"base\",\n  \"pool_address\": \"0x1111111111111111111111111111111111111111\",\n  \"cex_symbol\": \"TST000000USDT\",\n  \"meta\": {},\n  \"is_enabled\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/pairs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "pairs"
              ]
            }
          }
        },
        {
          "name": "Patch Pair (test)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pairId = pm.collectionVariables.get('createdPairId');",
                  "if (!pairId || pairId === 'null' || pairId === 'undefined') {",
                  "  throw new Error('createdPairId is empty. Create Pair (test) failed or was skipped.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_enabled\": false,\n  \"spread_threshold_override\": 0.42\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/pairs/{{createdPairId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "pairs",
                "{{createdPairId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('pair disabled', function () {",
                  "  pm.expect(json.is_enabled).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Pair (soft)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pairId = pm.collectionVariables.get('createdPairId');",
                  "if (!pairId || pairId === 'null' || pairId === 'undefined') {",
                  "  throw new Error('createdPairId is empty. Create Pair (test) failed or was skipped.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/pairs/{{createdPairId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "pairs",
                "{{createdPairId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('soft delete ok', function () {",
                  "  pm.expect(json.ok).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin Settings",
